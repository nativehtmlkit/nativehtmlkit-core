{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nativehtmlkit.dev/contracts/candidate-0.1/hello-params.schema.json",
  "type": "object",
  "properties": {
    "token": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "protocol_version": {
      "const": 1
    },
    "client": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "required": [
    "token",
    "protocol_version"
  ],
  "additionalProperties": true,
  "x-extracted": "Rust reads only token and protocol_version and currently ignores all other fields, including client"
}

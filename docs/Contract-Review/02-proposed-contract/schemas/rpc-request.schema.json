{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nativehtmlkit.dev/contracts/candidate-0.1/rpc-request.schema.json",
  "title": "NativeHTMLKit request envelope (candidate)",
  "type": "object",
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "x-max-utf8-bytes": 128,
      "description": "Rust caps request IDs at 128 UTF-8 BYTES, not Unicode codepoints; requires a runtime check in addition to JSON Schema."
    },
    "method": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!rpc\\.)[A-Za-z0-9._-]+$"
    },
    "params": {
      "type": "object"
    }
  },
  "required": [
    "jsonrpc",
    "id",
    "method"
  ],
  "additionalProperties": false,
  "x-status": "draft strict client request; host additionally accepts notification inputs"
}

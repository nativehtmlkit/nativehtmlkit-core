{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nativehtmlkit.dev/contracts/candidate-0.1/rpc-notification.schema.json",
  "type": "object",
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "method": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!rpc\\.)[A-Za-z0-9._-]+$"
    },
    "params": {
      "type": "object"
    }
  },
  "required": [
    "jsonrpc",
    "method"
  ],
  "additionalProperties": false
}
